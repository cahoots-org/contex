# Contex configuration. Copy to .env; `docker compose up` reads it.
# Every line shows the default. Uncomment a line to change it.
# Keep comments on their own line: text after a value becomes part of it.

# ============================================================
# Server
# ============================================================
# Bind address. The Docker image sets 0.0.0.0.
# CONTEX_HOST=127.0.0.1
# CONTEX_PORT=8001

# Refuse a non-loopback bind while auth is off. The compose file sets it to
# false, since the container binds 0.0.0.0 and publishes to loopback only.
# CONTEX_PROTECTED_MODE=true

# Largest request body, in bytes (50 MB).
# CONTEX_MAX_UPLOAD_SIZE=52428800

# ============================================================
# Database (ParadeDB: bundles pg_search and pgvector)
# ============================================================
# Must be postgresql+asyncpg://. Point it at Postgres directly or a
# session-mode pooler: live subscription updates need LISTEN/NOTIFY.
# DATABASE_URL=postgresql+asyncpg://contex:contex_password@localhost:5432/contex

# ============================================================
# Matching and search
# ============================================================
# Embedding model. The image bakes in the default; rebuild with
# --build-arg EMBED_MODEL=... if you change it.
# EMBED_MODEL=thenlper/gte-base
# Minimum cosine similarity for a match (0-1).
# SIMILARITY_THRESHOLD=0.5
# MAX_MATCHES=10
# Maximum context size in tokens.
# MAX_CONTEXT_SIZE=51200
# Fuse vector and BM25 results with reciprocal rank fusion (the compose file enables it).
# HYBRID_SEARCH_ENABLED=false
# RRF_K=60
# BM25 tokenizer: unicode_words, simple, whitespace, source_code or icu.
# Changing the tokenizer, K1 or B rebuilds the index at boot.
# BM25_TOKENIZER=unicode_words
# BM25_K1=1.2
# BM25_B=0.75
# OCR scanned PDF pages and images with Tesseract (Docker: --build-arg INSTALL_OCR=true).
# OCR_ENABLED=false
# Matched nodes returned per document.
# NODES_PER_DOCUMENT=3
# Nodes searched per requested document.
# CANDIDATE_POOL_FACTOR=10

# Rerank contex_query results with TypeSafe's Jev model. Needs both settings,
# and sends the query and candidate content to TypeSafe.
# SYSTEM_ONE_ENABLED=false
# TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-latest
# RERANK_DEPTH=30
# RERANK_CONCURRENCY=8
# RERANK_MAX_CHARS=4000
# RERANK_TIMEOUT=10

# ============================================================
# Limits
# ============================================================
# MAX_TOP_K=100
# MAX_NEEDS=50
# MAX_EVENT_COUNT=1000
# MAX_BATCH_SIZE=1000
# MAX_SUBSCRIPTIONS_PER_PROJECT=1000
# A subscription expires this long after its last create or read.
# SUBSCRIPTION_TTL_SECONDS=3600
# Full subscription reconcile interval. 0 disables reconcile; expired
# subscriptions are still purged.
# RECONCILE_SWEEP_SECONDS=300
# AUDIT_RETENTION_DAYS=90

# ============================================================
# Authentication and security
# ============================================================
# API-key auth, RBAC and tenant isolation.
# AUTH_ENABLED=false

# HMAC pepper for stored key hashes, at least 16 characters. Changing it
# invalidates every existing key.
# API_KEY_PEPPER=

# The first admin key, created at the first boot with auth on. Must start with
# ck_. Unset, a key is generated and printed once to stderr.
# BOOTSTRAP_ADMIN_KEY=
# BOOTSTRAP_ADMIN_NAME=root

# Comma-separated browser origins allowed to call Contex; empty allows none.
# CORS_ORIGINS=
# CORS_ALLOW_CREDENTIALS=true
# Hosts the server accepts besides localhost, e.g. contex.example.com. * disables the check.
# CONTEX_ALLOWED_HOSTS=
# ENABLE_HSTS=true

# Per-key request limits per window; 0 disables a limit. Counted per server process.
# RATE_LIMIT_WINDOW=60
# Queries and subscription creates (MCP and sandbox).
# RATE_LIMIT_QUERY=120
# contex_publish calls.
# RATE_LIMIT_PUBLISH=60
# contex_publish_batch and contex_delete calls.
# RATE_LIMIT_INGEST=0

# ============================================================
# Observability
# ============================================================
# DEBUG, INFO, WARNING, ERROR or CRITICAL.
# LOG_LEVEL=INFO
# LOG_JSON=true

# Bearer token for /metrics, at least 16 characters. Unset, /metrics is off.
# METRICS_TOKEN=

# OpenTelemetry spans to stdout and/or an OTLP collector.
# TRACING_CONSOLE_EXPORT=false
# TRACING_OTLP_EXPORT=false
# TRACING_OTLP_ENDPOINT=http://localhost:4317

# Sentry error tracking, on when SENTRY_DSN is set.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# SENTRY_SAMPLE_RATE=1.0
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_PROFILES_SAMPLE_RATE=0.1
# SENTRY_ENABLE_TRACING=true
