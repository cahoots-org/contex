# Contex configuration. Every variable below is read by the application.
# Values shown are the defaults; uncomment and change what you need.

# ============================================================
# Server
# ============================================================
CONTEX_HOST=0.0.0.0                 # Bind address (0.0.0.0 = all interfaces; 127.0.0.1 = loopback only)
CONTEX_PORT=8001                    # HTTP port

# Protected mode refuses a non-loopback bind when auth is disabled, to avoid
# exposing an unauthenticated server. The docker-compose dev stack sets this to
# false (it binds 0.0.0.0 inside the container). Leave true when running the
# binary directly with AUTH_ENABLED=false, or enable auth for network binds.
CONTEX_PROTECTED_MODE=true

# ============================================================
# Database (PostgreSQL / ParadeDB)
# ============================================================
# ParadeDB is required (bundles pg_search + pgvector). Must be postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://contex:contex_password@localhost:5432/contex

# ============================================================
# Redis (pub/sub notifications)
# ============================================================
REDIS_URL=redis://localhost:6379
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5
REDIS_SOCKET_KEEPALIVE=true
REDIS_HEALTH_CHECK_INTERVAL=30
REDIS_RETRY_ON_TIMEOUT=true
REDIS_DB=0
# REDIS_PASSWORD=

# Redis topology: "standalone" (default) or "sentinel".
REDIS_MODE=standalone
# REDIS_SENTINEL_HOSTS=host1:26379,host2:26379   # Required when REDIS_MODE=sentinel
# REDIS_SENTINEL_MASTER=mymaster
# REDIS_SENTINEL_PASSWORD=

# ============================================================
# Matching and hybrid search
# ============================================================
SIMILARITY_THRESHOLD=0.5            # Minimum cosine similarity for a match (0-1)
MAX_MATCHES=10                      # Maximum matches per need
MAX_CONTEXT_SIZE=51200             # Maximum context size in tokens
HYBRID_SEARCH_ENABLED=false         # Fuse pgvector + pg_search BM25 with RRF (the dev compose enables this)
RRF_K=60                            # Reciprocal Rank Fusion constant

# ============================================================
# Authentication and security
# ============================================================
AUTH_ENABLED=false                  # API-key auth + RBAC + tenant isolation. Off for local dev.

# Set both when AUTH_ENABLED=true.
# SERVICE_ACCOUNT_JWT_SECRET=        # required, or the server won't boot
# API_KEY_PEPPER=                    # recommended, at least 16 characters

# Bootstrap admin, created on first startup only when no API keys exist.
# BOOTSTRAP_ADMIN_KEY=              # Specific admin key to create; if unset, one is generated and logged once
BOOTSTRAP_ADMIN_NAME=root

CORS_ORIGINS=*                      # Comma-separated origins (* is insecure for production)
CORS_ALLOW_CREDENTIALS=true
ENABLE_HSTS=true                    # HTTP Strict Transport Security header

# ============================================================
# Retention
# ============================================================
RETENTION_AGENT_INACTIVE_DAYS=7          # Prune agents inactive this long
RETENTION_EVENTS_TTL_DAYS=30             # Event log time-to-live
RETENTION_MAX_EVENTS_PER_PROJECT=10000   # Cap on events retained per project
AUDIT_RETENTION_DAYS=90                  # Audit event retention

# ============================================================
# Webhooks
# ============================================================
WEBHOOKS_ENABLED=true
WEBHOOK_TIMEOUT=30                  # Delivery timeout in seconds
WEBHOOK_MAX_RETRIES=3               # Retry attempts (exponential backoff)

# ============================================================
# Logging
# ============================================================
LOG_LEVEL=INFO                      # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_JSON=true                       # JSON-structured logs

# ============================================================
# Tracing (OpenTelemetry)
# ============================================================
TRACING_CONSOLE_EXPORT=false        # Export spans to stdout (debugging)
TRACING_OTLP_EXPORT=false           # Export spans to an OTLP collector
TRACING_OTLP_ENDPOINT=http://localhost:4317

# ============================================================
# Error tracking (Sentry, optional)
# ============================================================
# SENTRY_DSN=                        # Set to enable Sentry
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=contex@0.2.0
SENTRY_SAMPLE_RATE=1.0              # Error sampling (0.0-1.0)
SENTRY_TRACES_SAMPLE_RATE=0.1      # Performance trace sampling
SENTRY_PROFILES_SAMPLE_RATE=0.1    # Profiling sampling
SENTRY_ENABLE_TRACING=true
