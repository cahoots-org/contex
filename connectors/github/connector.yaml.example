contex:
  url: http://localhost:8001/mcp
  project_id: my-app
  service_account_token: ${CONTEX_TOKEN}

source:
  token: ${GITHUB_TOKEN}
  repos:
    - cahoots-org/contex
  resources: [files, issues, pulls]
  state: all

batch_size: 200
include_binary: false

paths:
  exclude:
    - "*.lock"
    - "vendor/*"
    - "*.min.js"

# Add "commits" to source.resources to ingest commit history with full metadata
# (message, author, changed files, and additions/deletions). Each commit needs
# its own API call, so history is bounded: by default it starts at the latest
# published release, and a repo with no release is skipped unless you set `since`.
commits:
  # since: "2026-01-01T00:00:00Z"   # explicit lower bound; overrides the release default
  # branch: main                    # ref to read; defaults to the repo's default branch
